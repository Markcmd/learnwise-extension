{
    "manifest_version": 3,
    "name": "LearnWise",
    "version": "1.0.1",
    "description": "An extension to help you learn and retain vocabulary knowledge effectively.",
    "icons": {
        "16": "icons/LEARNWISE_16.png",
        "32": "icons/LEARNWISE_32.png",
        "48": "icons/LEARNWISE_48.png",
        "128": "icons/LEARNWISE_128.png",
        "500": "icons/LEARNWISE_500.png"
    },
    "background": {
        "service_worker": "JSs/background.js"
    },
    "host_permissions": ["https://api.learn-wise.net/*"],
    "permissions": ["storage", "activeTab", "windows"],
    "action": {
        "default_title": "LearnWise",
        "default_icon": {
            "16": "icons/LEARNWISE_16.png",
            "32": "icons/LEARNWISE_32.png",
            "48": "icons/LEARNWISE_48.png",
            "128": "icons/LEARNWISE_128.png"
        },
        "default_popup": "HTMLs/popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["JSs/contentScript.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["ecdict_json/*.json"],
            "matches": ["<all_urls>"]
        }
    ]

}